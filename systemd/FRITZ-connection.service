[Unit]
Description=FRITZ-connection: persistent IRC network connection for Fritz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/www/fritz/venv/bin/python3 /var/www/fritz/fritz-connection.py \
	--server chud.cyou \
	--port 6697 \
	--sasl-mechanism external \
	--sasl-cert /var/www/fritz/FRITZ.pem \
	--control-socket /run/fritz/FRITZ.sock
Restart=always
RestartSec=5
RuntimeDirectory=fritz
RuntimeDirectoryMode=0770
User=fritz
Group=fritz

StandardError=journal

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

[Unit]
Description=irc-link: persistent IRC network connection for AM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust server/port/socket path to taste. --no-tls if plaintext.
ExecStart=/var/www/fritz/venv/bin/python3 /var/www/fritz/fritz-connection.py \
	--server chud.cyou \
	--port 6697 \
	--control-socket /run/fritz/AM.sock
Restart=always
RestartSec=5
RuntimeDirectory=fritz
RuntimeDirectoryMode=0770
User=fritz
Group=fritz

StandardError=journal

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

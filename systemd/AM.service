[Unit]
Description=AM: IRC bot control process (arms, dispatch)
After=AM-connection.service
Requires=AM-connection.service
# NOT PartOf=irc-link.service: control restarting must never restart
# or stop irc-link. Requires= only enforces irc-link exists before
# this starts, it doesn't couple their lifecycles the other way.

[Service]
Type=simple
WorkingDirectory=/var/www/fritz
ExecStart=/var/www/fritz/venv/bin/python3 /var/www/fritz/bot_AM.py
User=fritz
Group=fritz

Restart=on-failure
RestartSec=5

StandardError=journal

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
